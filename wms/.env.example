# WMS environment — copy to .env and edit before first deploy.
POSTGRES_USER=wms
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wms
POSTGRES_PORT=5432

# Public URL / hostname served by Caddy
WMS_DOMAIN=wms.local
# Set to "https://wms.example.com" with a real DNS name for automatic TLS;
# leave as http:// for LAN-only / local testing without certificates.
WMS_SITE_ADDRESS=:80

APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-long-random-string
